# ============================================================================
# Plantilla de variables de entorno — Sistema Posadas San Andrés
# ============================================================================
# Copia este archivo como .env.local y rellena con tus claves reales.
# .env.local NO se sube a git (está en .gitignore).
# ============================================================================

# URL pública de tu proyecto Supabase
# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave pública (anon) de Supabase
# Settings → API → anon public
# Esta clave SÍ se envía al navegador. Es segura gracias a Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...tu_anon_key

# Clave de service role (SECRETO ABSOLUTO)
# Settings → API → service_role secret
# Esta clave NUNCA debe llegar al navegador. Solo úsala en código del servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJ...tu_service_role_key
